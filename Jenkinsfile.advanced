pipeline {

    agent any

    tools {
        nodejs 'NodeJS'
    }

    stages {

        stage('Preparación y Validación') {

            steps {

                echo "================================"
                echo "Validando estructura del proyecto"
                echo "================================"

                script {

                    def requiredFiles = [
                        'docker/docker-compose.test.yml',
                        'services/api-gateway/package.json',
                        'services/user-service/package.json',
                        'services/product-service/package.json'
                    ]

                    requiredFiles.each { file ->

                        if (!fileExists(file)) {
                            error "No existe el archivo: ${file}"
                        }

                    }

                }

            }

        }


        stage('Pruebas de Contrato') {

            steps {

                echo "Validación de contratos (omitida para la práctica)"

            }

        }


        stage('Instalar Dependencias') {

            parallel {


                stage('API Gateway') {

                    steps {

                        dir('services/api-gateway') {

                            bat 'npm install'

                        }

                    }

                }


                stage('User Service') {

                    steps {

                        dir('services/user-service') {

                            bat 'npm install'

                        }

                    }

                }


                stage('Product Service') {

                    steps {

                        dir('services/product-service') {

                            bat 'npm install'

                        }

                    }

                }


            }

        }


        stage('Levantar Contenedores') {

            steps {

                dir('docker') {

                    bat '''
                    docker compose -f docker-compose.test.yml up -d --build
                    '''

                }

            }

        }


        stage('Verificar Contenedores') {

            steps {

                bat '''
                docker ps
                '''

            }

        }

stage('Logs API Gateway') {
    steps {
        bat '''
        docker logs docker-api-gateway-1
        '''
    }
}
        stage('Health Check') {

           steps {
        bat '''
        echo Esperando que los servicios inicien...
        powershell.exe -Command "Start-Sleep -Seconds 10"

        powershell.exe -Command "try { Invoke-WebRequest http://localhost:3000/health -UseBasicParsing } catch { exit 1 }"
        '''
    }

        }


        stage('Pruebas API Gateway') {

            steps {

                dir('services/api-gateway') {

                    bat '''
                    npm test
                    '''

                }

            }

        }


        stage('Pruebas User Service') {

            steps {

                dir('services/user-service') {

                    bat '''
                    npm test
                    '''

                }

            }

        }


        stage('Pruebas Product Service') {

            steps {

                dir('services/product-service') {

                    bat '''
                    npm test
                    '''

                }

            }

        }


        stage('Logs Docker') {

           steps {
        bat '''
        docker compose -f docker/docker-compose.test.yml logs --tail=100
        '''
    }

        }

    }


    post {


        always {
        echo "Guardando logs..."

        bat '''
        docker ps -a
        docker logs docker-api-gateway-1 || exit 0
        docker logs docker-user-service-1 || exit 0
        docker logs docker-product-service-1 || exit 0
        '''

        dir('docker') {
            bat '''
            docker compose -f docker-compose.test.yml down -v
            '''
        }

        cleanWs()
    }

    success {
        echo "================================"
        echo "PIPELINE EXITOSO"
        echo "================================"
    }

    failure {
        echo "================================"
        echo "PIPELINE FALLÓ"
        echo "================================"
    }

    }


}